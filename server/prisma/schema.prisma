generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model band_rooms {
  id                Int                 @id @default(autoincrement())
  room_name         String?             @db.VarChar(100)
  hourly_rate       Decimal?            @db.Decimal(10, 2)
  status            String?             @db.VarChar(50)
  band_room_rentals band_room_rentals[]
}

model clients {
  id                Int                 @id @default(autoincrement())
  f_name            String?             @db.VarChar(100)
  m_name            String?             @db.VarChar(100)
  l_name            String?             @db.VarChar(100)
  phone             String?             @db.VarChar(20)
  email             String?
  address           String?             @db.Text
  users_id          Int?
  band_room_rentals band_room_rentals[]
  users             users?              @relation(fields: [users_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_clients_users")
  payments          payments[]
  rentals           rentals[]
  students          students[]

  @@index([users_id], map: "fk_clients_users")
}

model equipments {
  id             Int            @id @default(autoincrement())
  equipment_name String?        @db.VarChar(100)
  quantity       Int?
  brand          String?        @db.VarChar(100)
  rental_rate    Decimal?       @db.Decimal(10, 2)
  rate_type      String?        @db.VarChar(50)
  rental_items   rental_items[]
}

model instructors {
  id                     Int                      @id @default(autoincrement())
  staff_id               Int                      @unique(map: "staff_id")
  classes                classes[]
  instructor_specialties instructor_specialties[]
  staff                  staff                    @relation(fields: [staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_instructors_staff")
}

model instruments {
  id              Int            @id @default(autoincrement())
  instrument_name String?        @db.VarChar(100)
  brand           String?        @db.VarChar(100)
  model           String?        @db.VarChar(100)
  serial_number   String?        @db.VarChar(100)
  quantity        Int?
  status          String?        @db.VarChar(50)
  rental_rate     Decimal?       @db.Decimal(10, 2)
  rate_type       String?        @db.VarChar(50)
  purchase_date   DateTime?      @db.Date
  rental_items    rental_items[]
}

model learning_materials {
  id            Int       @id @default(autoincrement())
  title         String?   @db.VarChar(255)
  file_name     String?   @db.VarChar(255)
  file_path     String?   @db.Text
  uploaded_date DateTime? @db.DateTime(0)
  lesson_id     Int
  lesson        lesson    @relation(fields: [lesson_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_learning_materials_lesson")

  @@index([lesson_id], map: "fk_material_lesson")
}

model lesson {
  id                 Int                  @id @default(autoincrement())
  lesson_name        String?              @db.VarChar(100)
  status             String?              @db.VarChar(50)
  learning_materials learning_materials[]
  packages           packages[]
}

model lesson_rooms {
  id        Int       @id @default(autoincrement())
  room_name String?   @db.VarChar(100)
  status    String?   @db.VarChar(50)
  classes   classes[]
}

model packages {
  id            Int           @id @default(autoincrement())
  package_name  String?       @db.VarChar(100)
  duration      String?       @db.VarChar(100)
  session       Int?
  fee           Decimal       @db.Decimal(10, 2)
  status        String?       @db.VarChar(50)
  total_session Int?
  lesson_id     Int
  level_name    String?       @db.VarChar(100)
  classes       classes[]
  enrollments   enrollments[]
  lesson        lesson        @relation(fields: [lesson_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_packages_lesson")

  @@index([lesson_id], map: "fk_packages_lesson")
}

model rental_items {
  id            Int          @id @default(autoincrement())
  item_type     String?      @db.VarChar(50)
  quantity      Int?
  rental_fee    Decimal?     @db.Decimal(10, 2)
  rental_id     Int?
  instrument_id Int?
  equipment_id  Int?
  rental_rate   Decimal?     @db.Decimal(10, 2)
  subtotal      Decimal?     @db.Decimal(10, 2)
  equipments    equipments?  @relation(fields: [equipment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rental_items_equipment")
  instruments   instruments? @relation(fields: [instrument_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rental_items_instrument")
  rentals       rentals?     @relation(fields: [rental_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rental_items_rental")

  @@index([equipment_id], map: "fk_rental_items_equipment")
  @@index([instrument_id], map: "fk_rental_items_instrument")
  @@index([rental_id], map: "fk_rental_items_rental")
}

model rentals {
  id           Int            @id @default(autoincrement())
  rental_date  DateTime?      @db.DateTime(0)
  due_date     DateTime?      @db.DateTime(0)
  return_date  DateTime?      @db.DateTime(0)
  total_amount Decimal?       @db.Decimal(10, 2)
  status       String?        @db.VarChar(50)
  client_id    Int?
  payments     payments[]
  rental_items rental_items[]
  clients      clients?       @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rentals_client")

  @@index([client_id], map: "fk_rentals_client")
}

model role {
  id        Int     @id @default(autoincrement())
  role_name String  @db.VarChar(100)
  users     users[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model staff {
  id          Int          @id @default(autoincrement())
  f_name      String?      @db.VarChar(100)
  m_name      String?      @db.VarChar(100)
  l_name      String?      @db.VarChar(100)
  gender      String?      @db.VarChar(20)
  contact_no  String?      @db.VarChar(20)
  email       String?
  address     String?      @db.Text
  hire_date   DateTime?    @db.Date
  status      String?      @db.VarChar(50)
  instructors instructors?
  users       users[]
}

model students {
  id              Int           @id @default(autoincrement())
  student_number  String?       @db.VarChar(50)
  enrollment_date DateTime?     @db.Date
  guardian_name   String?       @db.VarChar(100)
  guardian_no     String?       @db.VarChar(20)
  status          String?       @db.VarChar(50)
  client_id       Int?
  email           String?
  users_id        Int?
  enrollments     enrollments[]
  payments        payments[]
  clients         clients?      @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_students_client")
  users           users?        @relation(fields: [users_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_students_users")

  @@index([client_id], map: "fk_students_client")
  @@index([users_id], map: "fk_students_users")
}

model users {
  id         Int        @id @default(autoincrement())
  email      String     @unique(map: "email")
  password   String     @db.VarChar(255)
  role_id    Int
  staff_id   Int?
  status     String?    @db.VarChar(50)
  created_at DateTime?  @default(now()) @db.DateTime(0)
  clients    clients[]
  students   students[]
  role       role       @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_role")
  staff      staff?     @relation(fields: [staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_staff")

  @@index([role_id], map: "fk_users_role")
  @@index([staff_id], map: "fk_users_staff")
}

model band_room_rentals {
  id           Int        @id @default(autoincrement())
  client_id    Int
  band_room_id Int
  rental_date  DateTime?  @db.Date
  start_time   DateTime?  @db.Time(0)
  end_time     DateTime?  @db.Time(0)
  total_amount Decimal?   @db.Decimal(10, 2)
  status       String?    @db.VarChar(50)
  clients      clients    @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_band_room_rental_client")
  band_rooms   band_rooms @relation(fields: [band_room_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_band_room_rental_room")
  payments     payments[]

  @@index([client_id], map: "fk_band_room_rental_client")
  @@index([band_room_id], map: "fk_band_room_rental_room")
}

model classes {
  id             Int           @id @default(autoincrement())
  package_id     Int
  instructor_id  Int
  lesson_room_id Int
  class_date     DateTime      @db.Date
  start_time     DateTime      @db.Time(0)
  end_time       DateTime      @db.Time(0)
  capacity       Int?
  status         String?       @default("Open") @db.VarChar(50)
  instructors    instructors   @relation(fields: [instructor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_classes_instructor")
  packages       packages      @relation(fields: [package_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_classes_package")
  lesson_rooms   lesson_rooms  @relation(fields: [lesson_room_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_classes_room")
  enrollments    enrollments[]

  @@index([instructor_id], map: "fk_classes_instructor")
  @@index([package_id], map: "fk_classes_package")
  @@index([lesson_room_id], map: "fk_classes_room")
}

model enrollments {
  id              Int        @id @default(autoincrement())
  student_id      Int
  class_id        Int
  package_id      Int
  amount          Decimal    @db.Decimal(10, 2)
  enrollment_date DateTime?  @db.Date
  start_date      DateTime?  @db.Date
  end_date        DateTime?  @db.Date
  status          String?    @default("Active") @db.VarChar(50)
  classes         classes    @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enrollments_class")
  packages        packages   @relation(fields: [package_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enrollments_package")
  students        students   @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enrollments_student")
  payments        payments[]

  @@index([class_id], map: "fk_enrollments_class")
  @@index([package_id], map: "fk_enrollments_package")
  @@index([student_id], map: "fk_enrollments_student")
}

model instructor_specialties {
  id            Int         @id @default(autoincrement())
  instructor_id Int
  specialty_id  Int
  instructors   instructors @relation(fields: [instructor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_instructor_specialty_instructor")
  specialties   specialties @relation(fields: [specialty_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_instructor_specialty_specialty")

  @@index([instructor_id], map: "fk_instructor_specialty_instructor")
  @@index([specialty_id], map: "fk_instructor_specialty_specialty")
}

model payments {
  id                  Int                @id @default(autoincrement())
  client_id           Int?
  student_id          Int?
  enrollment_id       Int?
  rental_id           Int?
  band_room_rental_id Int?
  amount              Decimal            @db.Decimal(10, 2)
  payment_date        DateTime?          @default(now()) @db.DateTime(0)
  payment_method      String?            @db.VarChar(50)
  status              String?            @default("Paid") @db.VarChar(50)
  band_room_rentals   band_room_rentals? @relation(fields: [band_room_rental_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_band_room_rental")
  clients             clients?           @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_client")
  enrollments         enrollments?       @relation(fields: [enrollment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_enrollment")
  rentals             rentals?           @relation(fields: [rental_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_rental")
  students            students?          @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_student")

  @@index([band_room_rental_id], map: "fk_payment_band_room_rental")
  @@index([client_id], map: "fk_payment_client")
  @@index([enrollment_id], map: "fk_payment_enrollment")
  @@index([rental_id], map: "fk_payment_rental")
  @@index([student_id], map: "fk_payment_student")
}

model specialties {
  id                     Int                      @id @default(autoincrement())
  specialty_name         String?                  @db.VarChar(255)
  status                 String?                  @default("Active") @db.VarChar(50)
  instructor_specialties instructor_specialties[]
}
